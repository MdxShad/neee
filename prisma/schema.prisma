generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  STAFF
  CONSULTANT
  AGENT
}

enum CommissionType {
  PERCENT
  FLAT
  ONE_TIME
}

enum AdmissionSource {
  DIRECT
  AGENT
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
}

enum ExpenseType {
  AGENT
  CONSULTANCY
  DAILY
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  role         Role
  parentId     String?
  parent       User?    @relation("UserHierarchy", fields: [parentId], references: [id])
  children     User[]   @relation("UserHierarchy")

  email        String?
  mobile       String?
  address      String?
  idProofUrl   String?
  isActive     Boolean  @default(true)

  passwordHash String
  permissions  Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]

  // Admissions
  admissionsCreated      Admission[] @relation("AdmissionsCreatedBy")
  admissionsAsConsultant Admission[] @relation("AdmissionsConsultant")
  admissionsAsAgent      Admission[] @relation("AdmissionsAgent")

  agentCommissions AgentCommission[] @relation("AgentCommissionAgent")

  expensesCreated Expense[] @relation("ExpenseCreatedBy")
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model University {
  id            String   @id @default(cuid())
  name          String
  location      String?
  contactPerson String?
  contactNumber String?
  email         String?
  address       String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courses       Course[]
  admissions    Admission[]
}

model Course {
  id            String   @id @default(cuid())
  universityId  String
  university    University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name          String
  duration      String?
  type          String?
  universityFee Int
  displayFee    Int
  session       String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agentCommissions AgentCommission[]
  admissions       Admission[]

  @@index([universityId])
}

model AgentCommission {
  id        String         @id @default(cuid())
  agentId   String
  agent     User           @relation("AgentCommissionAgent", fields: [agentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  type      CommissionType
  value     Int

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([agentId, courseId])
  @@index([courseId])
}

model Admission {
  id             String         @id @default(cuid())

  createdById    String
  createdBy      User           @relation("AdmissionsCreatedBy", fields: [createdById], references: [id])

  consultantId   String
  consultant     User           @relation("AdmissionsConsultant", fields: [consultantId], references: [id])

  agentId        String?
  agent          User?          @relation("AdmissionsAgent", fields: [agentId], references: [id])

  status         AdmissionStatus @default(SUBMITTED)

  studentName    String
  fatherName     String?
  mobile         String
  altMobile      String?
  address        String?
  dob            DateTime?
  gender         String?

  photoUrl       String?
  documents      Json?

  universityId   String
  university     University     @relation(fields: [universityId], references: [id])

  courseId       String
  course         Course         @relation(fields: [courseId], references: [id])

  amountReceived Int
  source         AdmissionSource

  // Snapshot fees
  universityFee           Int
  displayFee              Int
  consultancyProfit       Int

  agentCommissionType     CommissionType?
  agentCommissionValue    Int?
  agentCommissionAmount   Int

  agentExpensesTotal      Int @default(0)
  consultancyExpensesTotal Int @default(0)
  netProfit               Int @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  expenses        Expense[]

  universityLedger UniversityLedger?
  agentLedger      AgentLedger?
  profitLedger     ProfitLedger?

  @@index([consultantId])
  @@index([agentId])
  @@index([universityId])
  @@index([courseId])
  @@index([createdAt])
}

model Expense {
  id          String      @id @default(cuid())
  type        ExpenseType

  category    String?
  title       String
  amount      Int
  proofUrl    String?
  date        DateTime    @default(now())

  admissionId String?
  admission   Admission?  @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?       @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  createdAt   DateTime    @default(now())

  @@index([type])
  @@index([date])
  @@index([admissionId])
}

model UniversityLedger {
  id           String        @id @default(cuid())
  admissionId  String        @unique
  admission    Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  universityId String
  university   University    @relation(fields: [universityId], references: [id])

  amountPayable Int
  amountPaid    Int          @default(0)
  status        PaymentStatus @default(PENDING)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([universityId])
  @@index([status])
}

model AgentLedger {
  id           String        @id @default(cuid())
  admissionId  String        @unique
  admission    Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  agentId      String
  agent        User          @relation(fields: [agentId], references: [id])

  commissionAmount Int
  amountPaid       Int          @default(0)
  status           PaymentStatus @default(PENDING)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agentId])
  @@index([status])
}

model ProfitLedger {
  id           String    @id @default(cuid())
  admissionId  String    @unique
  admission    Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  grossProfit        Int
  agentCommission    Int
  agentExpenses      Int
  consultancyExpenses Int
  netProfit          Int

  createdAt DateTime @default(now())
}
